# MODELE UNIQUEMENT - NE METTEZ JAMAIS DE VRAIS MOTS DE PASSE ICI.
# Copiez ce fichier vers .env puis remplissez uniquement le fichier .env.
# Le fichier .env est ignore par Git.

# Application
MARKI_APP_NAME=MARKI
MARKI_APP_ENV=local
MARKI_APP_DEBUG=true
MARKI_APP_TIMEZONE=Africa/Algiers
MARKI_APP_BASE_PATH=/Marki_app/Partie_medecin/public
MARKI_APP_ORIGIN=http://localhost
MARKI_APP_KEY=GENERATE_LOCALLY

# Securite HTTP (production : true / domaine reel / false sauf proxy connu)
MARKI_FORCE_HTTPS=false
MARKI_ALLOWED_HOSTS=localhost,127.0.0.1
MARKI_TRUST_PROXY_HEADERS=false
MARKI_MAX_REQUEST_BYTES=1048576

# Base de donnees locale
MARKI_DB_HOST=127.0.0.1
MARKI_DB_PORT=3306
MARKI_DB_NAME=markii_db
MARKI_DB_CHARSET=utf8mb4
MARKI_DB_USERNAME=YOUR_LOCAL_DATABASE_USER
MARKI_DB_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD

# QR public
MARKI_QR_HMAC_SECRET=GENERATE_LOCALLY
# Laisser vide en utilisation normale.
# Test telephone : http://ADRESSE_IPV4_DU_PC:8080
MARKI_QR_PUBLIC_ORIGIN=
MARKI_QR_RATE_LIMIT_ATTEMPTS=20
MARKI_QR_RATE_LIMIT_MINUTES=15

# Authentification
MARKI_SESSION_NAME=marki_session
MARKI_IDLE_TIMEOUT_SECONDS=1800
MARKI_REMEMBER_DAYS=14
MARKI_MAX_FAILED_ATTEMPTS=5
MARKI_LOCK_MINUTES=15
MARKI_PASSWORD_MIN_LENGTH=12

# Administration interne MARKI
# Les identifiants admin sont stockes en base, pas dans .env.
MARKI_INVITATION_EXPIRY_HOURS=72
MARKI_PLATFORM_REMEMBER_DAYS=30
MARKI_PLATFORM_MAX_FAILED_ATTEMPTS=5
MARKI_PLATFORM_LOCK_MINUTES=15
MARKI_PLATFORM_IDLE_TIMEOUT_SECONDS=14400
# Optionnel : limiter l’administration interne à des IP fixes séparées par des virgules.
MARKI_PLATFORM_ALLOWED_IPS=
