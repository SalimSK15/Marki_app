# Application
MARKI_APP_NAME=MARKI
MARKI_APP_ENV=local
MARKI_APP_DEBUG=true
MARKI_APP_TIMEZONE=Africa/Algiers
MARKI_APP_BASE_PATH=/Marki_app/Partie_medecin/public
MARKI_APP_KEY=change-this-with-a-long-random-secret-of-at-least-32-characters

# Base de donnees Laragon
MARKI_DB_HOST=127.0.0.1
MARKI_DB_PORT=3307
MARKI_DB_NAME=markii_db
MARKI_DB_CHARSET=utf8mb4
MARKI_DB_USERNAME=marki_app
MARKI_DB_PASSWORD=replace-with-your-local-database-password

# QR public
MARKI_QR_HMAC_SECRET=change-this-with-another-long-random-secret-of-at-least-32-characters
# Laisser vide en utilisation normale.
# Pour tester avec un telephone sur le meme reseau prive : http://192.168.1.25
# Ne pas utiliser une adresse VirtualBox/WSL comme 192.168.56.1.
MARKI_QR_PUBLIC_ORIGIN=
MARKI_QR_RATE_LIMIT_ATTEMPTS=20
MARKI_QR_RATE_LIMIT_MINUTES=15

# Authentification
MARKI_SESSION_NAME=marki_session
MARKI_IDLE_TIMEOUT_SECONDS=43200
MARKI_REMEMBER_DAYS=30
MARKI_MAX_FAILED_ATTEMPTS=5
MARKI_LOCK_MINUTES=15
MARKI_PASSWORD_MIN_LENGTH=10

# Administration interne MARKI
MARKI_PLATFORM_SETUP_KEY=replace-with-a-long-random-platform-admin-key
MARKI_INVITATION_EXPIRY_HOURS=72
