# Copier vers .env sur le serveur et remplacer chaque valeur CHANGE_ME.
MARKI_APP_NAME=MARKI
MARKI_APP_ENV=production
MARKI_APP_DEBUG=false
MARKI_APP_TIMEZONE=Africa/Algiers
MARKI_APP_BASE_PATH=
MARKI_APP_ORIGIN=https://app.example.dz
MARKI_APP_KEY=CHANGE_ME_RANDOM_64_HEX_CHARACTERS

MARKI_FORCE_HTTPS=true
MARKI_ALLOWED_HOSTS=app.example.dz
MARKI_TRUST_PROXY_HEADERS=false
MARKI_MAX_REQUEST_BYTES=1048576

MARKI_DB_HOST=127.0.0.1
MARKI_DB_PORT=3306
MARKI_DB_NAME=markii_db
MARKI_DB_CHARSET=utf8mb4
MARKI_DB_USERNAME=marki_app
MARKI_DB_PASSWORD=CHANGE_ME_UNIQUE_DATABASE_PASSWORD

MARKI_QR_HMAC_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_HEX_CHARACTERS
MARKI_QR_PUBLIC_ORIGIN=https://app.example.dz
MARKI_QR_RATE_LIMIT_ATTEMPTS=20
MARKI_QR_RATE_LIMIT_MINUTES=15

MARKI_SESSION_NAME=marki_session
MARKI_IDLE_TIMEOUT_SECONDS=1800
MARKI_REMEMBER_DAYS=14
MARKI_MAX_FAILED_ATTEMPTS=5
MARKI_LOCK_MINUTES=15
MARKI_PASSWORD_MIN_LENGTH=12

MARKI_INVITATION_EXPIRY_HOURS=24
MARKI_PLATFORM_REMEMBER_DAYS=7
MARKI_PLATFORM_MAX_FAILED_ATTEMPTS=5
MARKI_PLATFORM_LOCK_MINUTES=30
MARKI_PLATFORM_IDLE_TIMEOUT_SECONDS=900
MARKI_PLATFORM_ALLOWED_IPS=
