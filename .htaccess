Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|\.env|\.sql|\.log|\.ini|\.bak|\.dist|\.example)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|\.env|\.sql|\.log|\.ini|\.bak|\.dist|\.example)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
